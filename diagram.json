{
  "version": 1,
  "author": "dragan-andrei",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -110,
      "left": 180,
      "attrs": { "temperature": "24", "humidity": "55" }
    },
    {
      "type": "wokwi-led",
      "id": "led_actuator",
      "top": -40,
      "left": -200,
      "attrs": { "color": "green" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_led",
      "top": 20,
      "left": -240,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX",  "$serialMonitor:RX", "", [] ],
    [ "esp:RX",  "$serialMonitor:TX", "", [] ],

    [ "dht1:VCC", "esp:3V3",   "red",    [] ],
    [ "dht1:GND", "esp:GND.1", "black",  [] ],
    [ "dht1:SDA", "esp:4",     "green",  [] ],

    [ "esp:2",         "r_led:1",         "green", [] ],
    [ "r_led:2",       "led_actuator:A",  "green", [] ],
    [ "led_actuator:C","esp:GND.2",       "black", [] ]
  ],
  "dependencies": {}
}
